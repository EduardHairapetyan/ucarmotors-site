---
/**
 * Brand mark — a rounded hexagon badge carrying the brand gradient, with the
 * bolt glyph knocked out in white. Geometry and colour stops are traced from
 * Ucar's own artwork (gradient measured at #43EBFC → #4480F4 → #5716D5).
 *
 * Still a redraw rather than the supplied file: when Ucar provide the logo in
 * vector form, drop it in `public/` and reference it here instead.
 */
interface Props {
  size?: number;
  class?: string;
  /** Soft outer glow, as the mark appears on the client's own artwork. */
  glow?: boolean;
}
const { size = 28, class: className = '', glow = false } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  role="img"
  aria-label="Ucar Motors"
>
  <defs>
    <linearGradient id={id} x1="0.05" y1="0" x2="0.95" y2="1">
      <stop offset="0" stop-color="var(--color-brand-cyan)" />
      <stop offset="0.48" stop-color="var(--color-brand-blue)" />
      <stop offset="1" stop-color="var(--color-brand-violet)" />
    </linearGradient>
    {glow && (
      <filter id={`${id}-g`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feComponentTransfer in="b" result="s">
          <feFuncA type="linear" slope="0.55" />
        </feComponentTransfer>
        <feMerge><feMergeNode in="s" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    )}
  </defs>

  <g filter={glow ? `url(#${id}-g)` : undefined}>
    <!-- Corners are rounded by stroking the polygon in its own fill with a
         round join, which keeps one path instead of six arc segments. -->
    <path
      d="M32 10 51 21v22L32 54 13 43V21Z"
      fill={`url(#${id})`}
      stroke={`url(#${id})`}
      stroke-width="7"
      stroke-linejoin="round"
    />
    <!-- Inner edge: a hairline of white at low opacity reads as the bevel on
         the original mark without introducing a second colour. -->
    <path
      d="M32 17.5 44.5 25v15L32 47.5 19.5 40V25Z"
      fill="none"
      stroke="#fff"
      stroke-width="1.5"
      stroke-linejoin="round"
      opacity="0.22"
    />
    <path d="M34.6 20 22 39.5h8.4l-1.8 9.5L42 29.4h-8.6z" fill="#fff" />
  </g>
</svg>
