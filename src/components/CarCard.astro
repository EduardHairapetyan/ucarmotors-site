---
/**
 * Catalogue tile.
 *
 * The bottom row is always a pill of the same shape, size and position: the
 * car's price when it is published, the call action when it is not. Nine of
 * the twelve cars have no published price, and none of them should look like
 * a card that failed to load.
 *
 * The pill shows the *price*, never a monthly payment. A payment figure is
 * derived from the financing rate, which is a different and less certain
 * thing than the price of the car — the calculator on the car's own page is
 * where that belongs.
 */
import CarSilhouette from './CarSilhouette.astro';
import Icon from './Icon.astro';
import { getEntry } from 'astro:content';
import { localePath, asset, formatAmd, useTranslations, pick, type Lang } from '../i18n/utils';
import { priceOf, type Car } from '../lib/catalog';

interface Props {
  car: Car;
  lang: Lang;
  /** Longest range in the catalogue — the range bar is relative, not absolute. */
  maxRange: number;
  /** Position in its grid, used only to stagger the scroll-reveal. */
  index?: number;
}

const { car, lang, maxRange, index = 0 } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const d = car.data;

const name = [d.brand, d.model].join(' ');
const href = localePath(lang, `/cars/${car.id}`);
const price = priceOf(car);
const rangePct = d.rangeKm && maxRange > 0 ? Math.round((d.rangeKm / maxRange) * 100) : 0;
const blurb = pick(d.description, lang);
const tel = site.phones[0].replace(/[^+\d]/g, '');
---

<article
  class="card card-hover h-full flex flex-col p-3"
  data-reveal
  style={`--reveal-delay:${(index % 3) * 80}ms`}
>
  <a href={href} class="inset relative aspect-[16/10] block no-underline">
    {d.images.length > 0 ? (
      <img
        src={asset(d.images[0])}
        alt={name}
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
        class="w-full h-full object-cover"
      />
    ) : (
      <CarSilhouette body={d.bodyType} class="w-full h-full" />
    )}

    {d.year && (
      <span class="absolute top-2.5 right-2.5 rounded-full bg-white/90 backdrop-blur px-2.5 py-1 text-xs font-extrabold">
        {d.year}
      </span>
    )}
  </a>

  <div class="flex flex-col flex-1 px-3 pt-4 pb-2 gap-2.5">
    <h3 class="text-[1.0625rem] font-extrabold leading-tight tracking-[-0.03em]">
      <a href={href} class="no-underline">{name}</a>
    </h3>

    <div class="flex items-center gap-3 flex-wrap">
      <span class:list={['status', d.status === 'available' && 'status-available']}>
        {t(`status.${d.status}` as 'status.available')}
      </span>
      <span class="text-xs font-bold text-ink-2">{t(`power.${d.powertrain}` as 'power.electric')}</span>
    </div>

    <!-- Range as a proportion of the fleet's longest. Absent when unknown —
         the gap is information too, and a fake bar would not be. -->
    {d.rangeKm ? (
      <div>
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-xs font-bold text-ink-2">{t('car.range')}</span>
          <span class="font-data text-xs font-bold">{d.rangeKm} km</span>
        </div>
        <div class="rangebar mt-1.5" title={`${d.rangeKm} km`}>
          <i style={`width:${rangePct}%`}></i>
        </div>
      </div>
    ) : (
      blurb && <p class="text-sm leading-relaxed text-ink-2 line-clamp-2">{blurb}</p>
    )}

    <div class="mt-auto pt-4">
      {price !== null ? (
        <a href={href} class="pill pill-money w-full">
          <b>{formatAmd(price, lang)}</b>
          <span class="text-ink-2 font-semibold">֏</span>
        </a>
      ) : (
        <a href={`tel:${tel}`} class="pill pill-primary w-full">
          <Icon name="phone" size={15} />{t('cta.call')}
        </a>
      )}
    </div>
  </div>
</article>
