---
import { monthlyPayment, formatAmd, useTranslations, type Lang } from '../i18n/utils';

interface Financing {
  ratePercent: number;
  minDownPercent: number;
  maxDownPercent: number;
  defaultDownPercent: number;
  minTermYears: number;
  maxTermYears: number;
  defaultTermYears: number;
  verified: boolean;
}

interface Props {
  price: number | null;
  financing: Financing;
  lang: Lang;
  /** 'lg' on the hero and car detail, 'sm' inside a card. */
  size?: 'lg' | 'sm';
  tone?: 'dark' | 'light';
  id: string;
}

const { price, financing: f, lang, size = 'lg', tone = 'light', id } = Astro.props;
const dark = tone === 'dark';
const t = useTranslations(lang);

// Rendered server-side so the figure is correct before any JS runs.
const initial = price ? monthlyPayment(price, f.defaultDownPercent, f.defaultTermYears, f.ratePercent) : 0;
const big = size === 'lg';
---

{price === null ? (
  <p class:list={['eyebrow', dark ? 'text-dim' : 'text-ink-2']} set:text={t('car.onRequest')} />
) : (
  <payment-calc
    data-price={price}
    data-rate={f.ratePercent}
    data-lang={lang}
    data-years={t('calc.years')}
    class:list={['block', dark && 'on-dark']}
  >
    <div class:list={['flex items-baseline gap-2', big ? 'mb-4' : 'mb-2']}>
      <output
        for={`${id}-down ${id}-term`}
        data-payment
        class:list={['payment', dark ? 'text-white' : 'text-ink', big ? 'text-5xl sm:text-6xl' : 'text-2xl']}
        set:text={formatAmd(initial, lang)}
      />
      <span
        class:list={[dark ? 'text-dim' : 'text-ink-2', 'font-medium', big ? 'text-sm' : 'text-xs']}
        set:text={t('calc.perMonth')}
      />
    </div>

    <div class:list={['grid gap-3', big ? 'sm:grid-cols-2' : '']}>
      <div>
        <label
          for={`${id}-down`}
          class:list={['flex justify-between items-baseline eyebrow mb-2', dark ? 'text-dim' : 'text-ink-2']}
        >
          <span set:text={t('calc.down')} />
          <span data-down-out class:list={['value font-semibold', dark ? 'text-white' : 'text-ink']}>{f.defaultDownPercent}%</span>
        </label>
        <input
          type="range"
          id={`${id}-down`}
          data-down
          min={f.minDownPercent}
          max={f.maxDownPercent}
          step="5"
          value={f.defaultDownPercent}
          class="w-full h-1.5 cursor-pointer"
        />
      </div>

      <div>
        <label
          for={`${id}-term`}
          class:list={['flex justify-between items-baseline eyebrow mb-2', dark ? 'text-dim' : 'text-ink-2']}
        >
          <span set:text={t('calc.term')} />
          <span data-term-out class:list={['value font-semibold', dark ? 'text-white' : 'text-ink']} set:text={`${f.defaultTermYears} ${t('calc.years')}`} />
        </label>
        <input
          type="range"
          id={`${id}-term`}
          data-term
          min={f.minTermYears}
          max={f.maxTermYears}
          step="1"
          value={f.defaultTermYears}
          class="w-full h-1.5 cursor-pointer"
        />
      </div>
    </div>

    <p class:list={[big ? 'mt-5' : 'mt-3', 'text-xs leading-relaxed max-w-prose', dark ? 'text-dim' : 'text-ink-2']}>
      {f.ratePercent}% {t('calc.rate')} · {t('calc.note')}
    </p>
  </payment-calc>
)}

<script>
  class PaymentCalc extends HTMLElement {
    #raf = 0;

    connectedCallback() {
      const price = Number(this.dataset.price);
      const rate = Number(this.dataset.rate);
      const lang = this.dataset.lang || 'hy';

      const out = this.querySelector<HTMLOutputElement>('[data-payment]');
      const down = this.querySelector<HTMLInputElement>('[data-down]');
      const term = this.querySelector<HTMLInputElement>('[data-term]');
      const downOut = this.querySelector<HTMLElement>('[data-down-out]');
      const termOut = this.querySelector<HTMLElement>('[data-term-out]');
      if (!out || !down || !term) return;

      // Passed in explicitly. Parsing it back out of the label breaks in any
      // locale where the unit is not space-separated from the number.
      const yearsWord = this.dataset.years ?? '';
      const nf = new Intl.NumberFormat(
        { hy: 'hy-AM', ru: 'ru-RU', en: 'en-US' }[lang] ?? 'hy-AM',
        { maximumFractionDigits: 0 }
      );
      const fmt = (n: number) => nf.format(Math.round(n)).replace(/[\u00A0,]/g, '\u202F');

      const payment = (d: number, y: number) => {
        const principal = price * (1 - d / 100);
        if (principal <= 0) return 0;
        const n = Math.round(y * 12);
        const i = rate / 100 / 12;
        if (i === 0) return principal / n;
        return (principal * i) / (1 - Math.pow(1 + i, -n));
      };

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let shown = payment(Number(down.value), Number(term.value));

      const render = () => {
        const target = payment(Number(down.value), Number(term.value));
        if (downOut) downOut.textContent = `${down.value}%`;
        if (termOut) termOut.textContent = `${term.value} ${yearsWord}`.trim();

        if (reduced) {
          shown = target;
          out.textContent = fmt(target);
          return;
        }

        // Short ease so the figure reads as an instrument settling, not a
        // slot machine. Cancels any in-flight tween.
        cancelAnimationFrame(this.#raf);
        const from = shown;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 180);
          const eased = 1 - Math.pow(1 - p, 3);
          shown = from + (target - from) * eased;
          out.textContent = fmt(shown);
          if (p < 1) this.#raf = requestAnimationFrame(step);
        };
        this.#raf = requestAnimationFrame(step);
      };

      down.addEventListener('input', render);
      term.addEventListener('input', render);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.#raf);
    }
  }

  if (!customElements.get('payment-calc')) {
    customElements.define('payment-calc', PaymentCalc);
  }
</script>
