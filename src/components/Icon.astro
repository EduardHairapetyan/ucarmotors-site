---
/**
 * Single inline-SVG icon set. One source for every glyph so paths do not
 * drift between components. Icons are decorative (`aria-hidden`); the link
 * or button around them must carry its own text or `aria-label`.
 */
interface Props {
  name:
    | 'facebook' | 'instagram' | 'linkedin' | 'whatsapp' | 'telegram'
    | 'globe' | 'chevron-down' | 'phone' | 'mail' | 'map-pin' | 'external'
    | 'menu' | 'close' | 'arrow-right' | 'check' | 'clock'
    | 'car' | 'bolt' | 'shield' | 'wrench' | 'card';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;

/** Outline glyphs stroke `currentColor`; brand marks fill it. */
const OUTLINE = new Set([
  'instagram', 'globe', 'chevron-down', 'phone', 'mail', 'map-pin', 'external',
  'menu', 'close', 'arrow-right', 'check', 'clock',
  'car', 'bolt', 'shield', 'wrench', 'card',
]);
const outline = OUTLINE.has(name);

const PATHS: Record<Props['name'], string> = {
  facebook:
    '<path d="M15.5 8.5V6.6c0-.8.2-1.1 1.1-1.1h1.6V2.1C17.7 2 16.7 2 15.6 2c-2.6 0-4.1 1.6-4.1 4.4v2.1H8.5V12h3v10h4V12h3l.5-3.5h-3.5Z"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.8"/><circle cx="16.9" cy="7.1" r="1.1" fill="currentColor" stroke="none"/>',
  linkedin:
    '<path d="M20.5 2h-17A1.5 1.5 0 0 0 2 3.5v17A1.5 1.5 0 0 0 3.5 22h17a1.5 1.5 0 0 0 1.5-1.5v-17A1.5 1.5 0 0 0 20.5 2ZM8 19H5v-9h3v9ZM6.5 8.3a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5ZM19 19h-3v-4.7c0-1.2 0-2.6-1.6-2.6S12.6 12.9 12.6 14V19h-3v-9h2.9v1.2h.1a3.2 3.2 0 0 1 2.9-1.6c3 0 3.5 2 3.5 4.5V19Z"/>',
  whatsapp:
    '<path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.3-1.7-1.3-3.2s.8-2.2 1.1-2.5c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.5-.3.3c-.1.1-.3.3-.1.6.2.4.9 1.4 1.9 2.3 1.2 1 2 1.3 2.3 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.9-.1 1.5Z"/>',
  telegram:
    '<path d="M21.9 3.2 2.9 10.6c-1 .4-1 1.4 0 1.7l4.7 1.5 1.8 5.6c.2.6.6.7 1.1.3l2.7-2.4 4.5 3.3c.6.4 1.3.1 1.5-.6l3.3-15.4c.2-.9-.6-1.5-1.4-1.2ZM8.9 13.5l8.7-5.4c.4-.2.7.3.4.6l-7 6.4-.3 3-1.8-4.6Z"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 3.8 5.7 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3Z"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  phone:
    '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  'map-pin': '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  external: '<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="m6 6 12 12"/><path d="m18 6-12 12"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.4 2"/>',

  /* The showroom's five services, one glyph each. */
  car:
    '<path d="M4 16.5v2.2a.8.8 0 0 1-.8.8H2.8a.8.8 0 0 1-.8-.8V11l2.4-5.4A2 2 0 0 1 6.2 4.4h11.6a2 2 0 0 1 1.8 1.2L22 11v7.7a.8.8 0 0 1-.8.8h-.4a.8.8 0 0 1-.8-.8v-2.2"/><path d="M2 11h20"/><circle cx="7" cy="14" r="1.3"/><circle cx="17" cy="14" r="1.3"/>',
  bolt: '<path d="M13.5 2.5 5 13.5h5.5L9.8 21.5 18.5 10h-5.6z"/>',
  shield: '<path d="M12 2.5 20 6v6c0 5-3.4 8.3-8 9.5C7.4 20.3 4 17 4 12V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  wrench:
    '<path d="M15.2 3.4a5.5 5.5 0 0 0-6.6 7.1L3 16.1a2 2 0 0 0 0 2.8l2.1 2.1a2 2 0 0 0 2.8 0l5.6-5.6a5.5 5.5 0 0 0 7.1-6.6l-3.1 3.1-3-.4-.4-3z"/>',
  card: '<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/><path d="M6.5 14.8h3.2"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={outline ? 'none' : 'currentColor'}
  stroke={outline ? 'currentColor' : 'none'}
  stroke-width={outline ? 1.75 : undefined}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={PATHS[name]}
/>
