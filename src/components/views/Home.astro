---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarCard from '../CarCard.astro';
import CarSilhouette from '../CarSilhouette.astro';
import Icon from '../Icon.astro';
import { getCars, getFeatured, maxRange, entryPrice, priceOf } from '../../lib/catalog';
import { localePath, asset, useTranslations, pick, formatAmd, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const cars = await getCars();
const featured = await getFeatured(3);
const max = maxRange(cars);
const entry = entryPrice(cars);

const services = [
  t('svc.sales'),
  t('svc.charging'),
  t('svc.warranty'),
  t('svc.service'),
  t('svc.financing'),
];

// The hero anchors on a real car at a real price rather than an abstract
// "from" figure, so the number on screen is one you can go and buy.
const heroCar = entry?.car ?? featured[0]!;
const heroPrice = entry?.price ?? priceOf(heroCar);
const heroName = `${heroCar.data.brand} ${heroCar.data.model}`;
---

<Base lang={lang} title={t('hero.title')} description={t('hero.lede')}>
  <!-- Light hero. The brand mark reads on white, so the page opens the way
       the logo does — bright, with the gradient as the one colour event. -->
  <section class="relative overflow-hidden bg-mist">
    <div
      class="pointer-events-none absolute -top-48 -right-40 h-[42rem] w-[42rem] rounded-full opacity-25 blur-3xl"
      style="background:var(--gradient-brand)"
      aria-hidden="true"
    ></div>

    <div class="shell relative pt-8 pb-12 sm:pt-14 lg:pt-20 lg:pb-20">
      <div class="grid gap-8 lg:gap-14 lg:grid-cols-[0.95fr_1.15fr] lg:items-center">
        <div>
          <p class="eyebrow text-signal">{t('hero.eyebrow')}</p>
          <h1 class="text-hero mt-5 text-ink">{t('hero.title')}</h1>
          <p class="mt-5 leading-relaxed text-ink-2 max-w-[46ch]">{t('hero.lede')}</p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={localePath(lang, '/cars')} class="btn btn-primary w-full sm:w-auto">{t('nav.cars')}</a>
            <a href={localePath(lang, '/contact')} class="btn btn-on-light hidden lg:inline-flex">{t('nav.contact')}</a>
          </div>
        </div>

        <a href={localePath(lang, `/cars/${heroCar.id}`)} class="block no-underline">
          <div class="aspect-[2/1] sm:aspect-[16/10] bg-white overflow-hidden ring-1 ring-line">
            {heroCar.data.images.length > 0 ? (
              <img src={asset(heroCar.data.images[0])} alt={heroName} width="1000" height="625" class="w-full h-full object-cover" />
            ) : (
              <CarSilhouette body={heroCar.data.bodyType} tone="light" class="w-full h-full" />
            )}
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mt-4">
            <h2 class="text-lg font-semibold text-ink">{heroName}</h2>
            {heroPrice !== null ? (
              <span class="font-data text-sm text-ink-2 whitespace-nowrap">{t('cta.from')} {formatAmd(heroPrice, lang)} ֏</span>
            ) : (
              <span class="eyebrow text-charge">{t(`status.${heroCar.data.status}` as 'status.available')}</span>
            )}
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Who Ucar Motors is and what they do, sourced from the showroom's own
       service list. A tinted band so the page has a colour beat, not just
       black and white. -->
  <section class="bg-wash border-y border-line">
    <div class="shell py-16 sm:py-20" data-reveal>
      <p class="eyebrow text-signal">{t('about.eyebrow')}</p>
      <h2 class="text-title mt-4 max-w-[22ch] text-ink">{t('about.title')}</h2>
      <p class="mt-5 text-ink-2 leading-relaxed max-w-[54ch]">{t('about.lede')}</p>
      <div class="mt-10 h-[3px] w-24" style="background:var(--gradient-brand)" aria-hidden="true"></div>
      <ul class="mt-8 grid gap-x-10 gap-y-4 text-sm sm:grid-cols-2 lg:grid-cols-3 max-w-3xl">
        {services.map((s, i) => (
          <li data-reveal style={`--reveal-delay:${i * 60}ms`}>{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Catalogue on white: prices and specs read as a spec sheet. -->
  <section class="shell py-16 sm:py-24">
    <div class="flex items-end justify-between gap-4 border-b border-line pb-5 mb-8" data-reveal>
      <h2 class="text-title">{t('cars.title')}</h2>
      <a href={localePath(lang, '/cars')} class="eyebrow no-underline text-ink-2 hover:text-ink whitespace-nowrap">
        {t('cta.viewAll')} →
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((car, i) => (
        <CarCard car={car} lang={lang} financing={site.financing} maxRange={max} index={i} />
      ))}
    </div>
  </section>

  <section class="bg-white border-t border-line">
    <div class="shell py-16 sm:py-20 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between lg:gap-16 max-w-5xl" data-reveal>
      <div>
        <h2 class="text-title text-ink max-w-[18ch]">{t('contact.title')}</h2>
        <p class="mt-5 text-ink-2 leading-relaxed max-w-[40ch]">
          {pick(site.address, lang)} · {pick(site.hours, lang)}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:shrink-0">
        <a href={localePath(lang, '/contact')} class="btn btn-primary w-full sm:w-auto lg:w-full">{t('nav.contact')}</a>
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn btn-on-light w-full sm:w-auto lg:w-full">
          <Icon name="whatsapp" size={16} />WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
