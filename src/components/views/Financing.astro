---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PaymentCalculator from '../PaymentCalculator.astro';
import Icon from '../Icon.astro';
import { getCars, entryPrice } from '../../lib/catalog';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const f = site.financing;
const cars = await getCars();
const entry = entryPrice(cars);
const tel = site.phones[0].replace(/[^+\d]/g, '');

const DOCS: Record<Lang, string[]> = {
  hy: ['Անձնագիր կամ նույնականացման քարտ', 'Սոցիալական քարտ', 'Եկամուտը հաստատող տեղեկանք', 'Վարորդական վկայական'],
  ru: ['Паспорт или ID-карта', 'Социальная карта', 'Справка о доходах', 'Водительское удостоверение'],
  en: ['Passport or ID card', 'Social security card', 'Proof of income', "Driver's licence"],
};

const terms = [
  { label: t('calc.rate'), value: `${f.ratePercent}%` },
  { label: t('calc.down'), value: `${f.minDownPercent}–${f.maxDownPercent}%` },
  { label: t('calc.term'), value: `${f.minTermYears}–${f.maxTermYears}`, unit: t('calc.years') },
];
---

<Base lang={lang} title={t('fin.title')} description={t('fin.lede')}>
  <section class="shell pt-8 pb-4 sm:pt-12">
    <div class="relative overflow-hidden card p-8 sm:p-10">
      <div class="spill -top-40 -right-20 h-72 w-[26rem]" aria-hidden="true"></div>
      <div class="relative">
        <h1 class="text-title max-w-[18ch]">{t('fin.title')}</h1>
        <p class="mt-4 text-lede text-ink-2 max-w-[50ch] leading-relaxed">{t('fin.lede')}</p>

        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-5">
          {terms.map((x) => (
            <div>
              <dt class="label">{x.label}</dt>
              <dd class="figure text-2xl mt-1"><span class="payment">{x.value}</span>{x.unit && <span class="unit">{x.unit}</span>}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- The rate on this page is not yet confirmed by the dealership, and every
       figure the calculator prints is derived from it. The disclosure stays
       until `financing.verified` is set in the CMS. -->
  {!f.verified && (
    <section class="shell pb-2">
      <div class="card p-5 border-l-[3px] border-l-danger flex items-start gap-3">
        <span class="text-danger shrink-0 mt-0.5"><Icon name="clock" size={18} /></span>
        <p class="text-sm text-ink-2 leading-relaxed max-w-[64ch]">{t('fin.unverified')}</p>
      </div>
    </section>
  )}

  <section class="shell pt-6">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:gap-8 items-start">
      <div class="card relative overflow-hidden p-8 sm:p-10" data-reveal>
        <div class="spill -bottom-32 -left-20 h-64 w-80" aria-hidden="true"></div>
        <div class="relative">
          <p class="label">{t('calc.title')}</p>
          {entry && (
            <p class="mt-1">
              <a href={localePath(lang, `/cars/${entry.car.id}`)} class="text-sm font-bold no-underline hover:text-signal transition-colors">{entry.car.data.brand} {entry.car.data.model}</a>
            </p>
          )}

          <div class="mt-5">
            <PaymentCalculator price={entry?.price ?? null} financing={f} lang={lang} size="lg" tone="light" id="fin" />
          </div>

          <a href={localePath(lang, '/cars')} class="pill pill-primary mt-8">
            {t('nav.cars')}<Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <div class="card p-8 sm:p-10" data-reveal>
        <h2 class="text-xl font-extrabold tracking-[-0.03em]">{t('fin.docs')}</h2>
        <!-- A checklist, not a sequence: these are four things to bring, and
             numbering them would imply an order that does not exist. -->
        <ul class="mt-6 space-y-2.5 list-none p-0">
          {DOCS[lang].map((doc) => (
            <li class="flex items-center gap-3">
              <span class="badge !w-6 !h-6 shrink-0"><Icon name="check" size={13} /></span>
              <span class="text-[0.9375rem]">{doc}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 pt-7 border-t border-line">
          <div class="flex flex-wrap gap-3">
            <a href={`tel:${tel}`} class="pill pill-primary">
              <Icon name="phone" size={15} />{t('cta.call')}
            </a>
            <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="pill pill-ghost">
              <Icon name="whatsapp" size={16} />WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
