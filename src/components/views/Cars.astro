---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarCard from '../CarCard.astro';
import Icon from '../Icon.astro';
import { getCars, maxRange, brandsOf } from '../../lib/catalog';
import { localePath, useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const cars = await getCars();
const max = maxRange(cars);
const brands = brandsOf(cars);
---

<Base lang={lang} title={t('cars.title')} description={t('hero.lede')}>
  <section class="shell pt-8 pb-4 sm:pt-12">
    <div class="relative overflow-hidden card p-8 sm:p-10">
      <div class="spill -top-40 -right-24 h-72 w-96" aria-hidden="true"></div>
      <div class="relative flex flex-wrap items-end justify-between gap-6">
        <div>
          <h1 class="text-title">{t('cars.title')}</h1>
          <p class="mt-3 text-ink-2 leading-relaxed max-w-[46ch]">{t('hero.lede')}</p>
        </div>
        <dl class="flex gap-8">
          <div>
            <dt class="label capitalize">{t('cars.count')}</dt>
            <dd class="payment text-2xl mt-1"><span data-count>{cars.length}</span></dd>
          </div>
          <div>
            <dt class="label capitalize">{t('calc.rate')}</dt>
            <dd class="payment text-2xl mt-1">{site.financing.ratePercent}%</dd>
          </div>
          <div>
            <dt class="label">{t('calc.term')}</dt>
            <dd class="payment text-2xl mt-1 whitespace-nowrap">
              {site.financing.maxTermYears}
              <span class="font-sans text-base font-bold text-ink-2">{t('calc.years')}</span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Filters are an enhancement: with JS off every car is already in the
       DOM and visible, so the page still works. -->
  <car-filter class="block shell pb-4">
    <fieldset class="flex flex-wrap items-center gap-2 border-0 p-0 m-0 pt-6">
      <legend class="label mb-3 w-full">{t('filter.brand')}</legend>
      <button type="button" data-brand="" aria-pressed="true" class="chip">{t('filter.all')}</button>
      {brands.map((brand) => (
        <button type="button" data-brand={brand} aria-pressed="false" class="chip">{brand}</button>
      ))}
    </fieldset>

    <div class="grid gap-5 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-8" data-grid>
      {cars.map((car, i) => (
        <div data-car data-car-brand={car.data.brand}>
          <CarCard car={car} lang={lang} financing={site.financing} maxRange={max} index={i} />
        </div>
      ))}
    </div>

    <div data-empty hidden class="card p-10 mt-8 text-center">
      <p class="text-ink-2">{t('cars.empty')}</p>
      <button type="button" data-reset class="pill pill-ghost pill-sm mt-5">{t('filter.all')}</button>
    </div>
  </car-filter>

  <section class="shell pt-12" data-reveal>
    <div class="card p-8 sm:p-10 flex flex-wrap items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-extrabold tracking-[-0.03em]">{t('car.onRequest')}</h2>
        <p class="mt-2 text-ink-2 max-w-[42ch] leading-relaxed">{t('calc.note')}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="pill pill-primary">
          <Icon name="phone" size={15} />{site.phones[0]}
        </a>
        <a href={localePath(lang, '/contact')} class="pill pill-ghost">{t('nav.contact')}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  class CarFilter extends HTMLElement {
    connectedCallback() {
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-brand]')];
      const cards = [...this.querySelectorAll<HTMLElement>('[data-car]')];
      const empty = this.querySelector<HTMLElement>('[data-empty]');
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]');
      const count = document.querySelector<HTMLElement>('[data-count]');

      const apply = (brand: string) => {
        let shown = 0;
        for (const card of cards) {
          const match = !brand || card.dataset.carBrand === brand;
          card.hidden = !match;
          if (match) shown++;
        }
        if (empty) empty.hidden = shown > 0;
        if (count) count.textContent = String(shown);

        for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.brand === brand));

        // Keep the choice in the URL so a filtered view is shareable and
        // survives the back button.
        const url = new URL(location.href);
        brand ? url.searchParams.set('brand', brand) : url.searchParams.delete('brand');
        history.replaceState(null, '', url);
      };

      for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.brand ?? ''));
      reset?.addEventListener('click', () => apply(''));

      const initial = new URL(location.href).searchParams.get('brand') ?? '';
      if (initial && buttons.some((b) => b.dataset.brand === initial)) apply(initial);
    }
  }

  if (!customElements.get('car-filter')) customElements.define('car-filter', CarFilter);
</script>
