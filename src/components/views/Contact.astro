---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { useTranslations, pick, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

// Prefer the exact pin pasted in the CMS; otherwise geocode the street
// address (English query — Google resolves the Latin form reliably). Either
// way the map has to be told which language to label itself in, or a pinned
// URL renders its controls in whatever Google guesses.
const mapBase =
  site.mapEmbed ||
  `https://www.google.com/maps?q=${encodeURIComponent(site.address.en)}&z=15&output=embed`;
const mapSrc = mapBase.includes('hl=') ? mapBase : `${mapBase}&hl=${lang}`;

const social = [
  { href: site.social.facebook, name: 'facebook' as const, label: 'Facebook' },
  { href: site.social.instagram, name: 'instagram' as const, label: 'Instagram' },
  { href: site.social.linkedin, name: 'linkedin' as const, label: 'LinkedIn' },
];
---

<Base lang={lang} title={t('contact.title')} description={pick(site.address, lang)}>
  <section class="shell pt-8 pb-4 sm:pt-12">
    <div class="relative overflow-hidden card p-8 sm:p-10">
      <div class="spill -top-40 -left-16 h-72 w-[26rem]" aria-hidden="true"></div>
      <div class="relative">
        <h1 class="text-title max-w-[16ch]">{t('contact.title')}</h1>
        <p class="mt-4 text-lede text-ink-2 max-w-[46ch] leading-relaxed">{pick(site.address, lang)}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="pill pill-primary">
            <Icon name="phone" size={15} />{site.phones[0]}
          </a>
          <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="pill pill-ghost">
            <Icon name="whatsapp" size={16} />WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="shell pt-2">
    <div class="grid gap-5 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="card p-7" data-reveal>
        <span class="badge"><Icon name="phone" size={17} /></span>
        <p class="label mt-4">{t('contact.phone')}</p>
        <ul class="mt-2 space-y-1.5 list-none p-0">
          {site.phones.map((p) => (
            <li>
              <a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="text-[0.9375rem] font-bold no-underline hover:text-signal transition-colors">{p}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="card p-7" data-reveal style="--reveal-delay:60ms">
        <span class="badge"><Icon name="mail" size={17} /></span>
        <p class="label mt-4">{t('contact.email')}</p>
        <p class="mt-2">
          <a href={`mailto:${site.email}`} class="text-[0.9375rem] font-bold no-underline hover:text-signal transition-colors break-all">{site.email}</a>
        </p>
      </div>

      <div class="card p-7" data-reveal style="--reveal-delay:120ms">
        <span class="badge"><Icon name="clock" size={17} /></span>
        <p class="label mt-4">{t('contact.hours')}</p>
        <p class="mt-2 text-[0.9375rem] font-bold">{pick(site.hours, lang)}</p>
      </div>

      <div class="card p-7 sm:col-span-2" data-reveal>
        <span class="badge"><Icon name="map-pin" size={17} /></span>
        <p class="label mt-4">{t('contact.address')}</p>
        <p class="mt-2 text-[0.9375rem] leading-relaxed">{pick(site.address, lang)}</p>
        <a href={site.mapUrl} rel="noopener" class="pill pill-soft pill-sm mt-4">
          <Icon name="external" size={14} />{t('contact.map')}
        </a>
      </div>

      <div class="card p-7" data-reveal style="--reveal-delay:60ms">
        <p class="label">{t('contact.social')}</p>
        <div class="mt-3 flex gap-2">
          {social.map((s) => (
            <a
              href={s.href}
              rel="noopener"
              aria-label={s.label}
              class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-page text-ink-2 hover:text-signal hover:bg-mist transition-colors"
            >
              <Icon name={s.name} size={19} />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="shell pt-6" data-reveal>
    <p class="label mb-3">{t('contact.findUs')}</p>
    <div class="card overflow-hidden">
      <div class="aspect-[16/11] sm:aspect-[21/9] bg-mist">
        <iframe
          src={mapSrc}
          title={pick(site.address, lang)}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
          style="border:0"
        ></iframe>
      </div>
    </div>
  </section>
</Base>
