---
/**
 * The header is a floating card rather than a band ruled off the page — the
 * same rounded surface everything else on the site sits on.
 *
 * Navigation on a phone is a disclosure panel, not a sideways-scrolling strip:
 * three links that scroll out of reach are three links nobody uses. Both the
 * language switcher and the menu are `<details>`, so they work with scripts
 * off; the script below only adds outside-click and Escape.
 */
import { localePath, useTranslations, stripLocale, type Lang } from '../i18n/utils';
import { languages, locales } from '../i18n/ui';
import { getEntry } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Flag from './Flag.astro';

interface Props {
  lang: Lang;
  /**
   * Where the language switcher should send you, overriding "the same page in
   * the other language". The 404 is served at every unknown URL, so there is
   * no equivalent page to switch to — without this, changing language on a
   * 404 lands you on another 404.
   */
  langTarget?: string;
}
const { lang, langTarget } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const tel = site.phones[0].replace(/[^+\d]/g, '');

const here = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';
const switchTo = langTarget ?? here;
const nav = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];
const isOn = (href: string) => here === href || here.startsWith(href + '/');
---

<header class="sticky top-0 z-40 px-3 pt-3 pb-1">
  <div class="shell !px-0">
    <div class="card flex items-center gap-3 sm:gap-4 h-14 sm:h-16 px-3 sm:px-5">
      <a href={localePath(lang, '/')} class="no-underline flex items-center gap-2.5 shrink-0">
        <Logo size={26} />
        <span class="flex items-baseline gap-1.5 text-[0.9375rem] tracking-[-0.03em]">
          <span class="wordmark-brand font-extrabold">UCAR</span>
          <span class="font-bold text-ink-2">MOTORS</span>
        </span>
      </a>

      <nav aria-label="Main" class="hidden md:flex items-center gap-1 ml-auto">
        {nav.map((item) => (
          <a
            href={localePath(lang, item.href)}
            aria-current={isOn(item.href) ? 'page' : undefined}
            class:list={[
              'px-3.5 py-2 rounded-full text-sm font-bold no-underline whitespace-nowrap transition-colors',
              isOn(item.href) ? 'bg-mist text-ink' : 'text-ink-2 hover:text-ink hover:bg-page',
            ]}
          >{item.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-1.5 sm:gap-2 ml-auto md:ml-0">
        <details class="lang-menu relative">
          <summary
            aria-label={t('lang.label')}
            class="flex items-center gap-1.5 cursor-pointer select-none px-2 py-2 rounded-full text-ink-2 hover:bg-page transition-colors"
          >
            <Flag code={lang} size={18} />
            <span class="text-xs font-extrabold uppercase tracking-[0.06em] text-ink">{lang}</span>
            <Icon name="chevron-down" size={12} class="lang-caret transition-transform" />
          </summary>
          <ul class="card absolute right-0 top-full mt-2 z-50 min-w-[10.5rem] p-1.5 list-none">
            {locales.map((code) => (
              <li>
                <a
                  href={localePath(code, switchTo)}
                  hreflang={code}
                  lang={code}
                  aria-current={code === lang ? 'true' : undefined}
                  class:list={[
                    'flex items-center gap-2.5 px-3 py-2.5 rounded-[12px] text-sm font-semibold no-underline transition-colors',
                    code === lang ? 'bg-mist text-ink' : 'text-ink-2 hover:text-ink hover:bg-page',
                  ]}
                >
                  <Flag code={code} size={18} />
                  <span>{languages[code]}</span>
                  {code === lang && <Icon name="check" size={14} class="ml-auto text-signal" />}
                </a>
              </li>
            ))}
          </ul>
        </details>

        <a href={`tel:${tel}`} class="pill pill-primary pill-sm hidden sm:inline-flex shrink-0">
          <Icon name="phone" size={14} />{t('cta.call')}
        </a>

        <details class="menu md:hidden relative">
          <summary
            aria-label={t('nav.menu')}
            class="flex items-center justify-center cursor-pointer select-none w-9 h-9 rounded-full text-ink hover:bg-page transition-colors"
          >
            <Icon name="menu" size={20} class="menu-open" />
            <Icon name="close" size={20} class="menu-close hidden" />
          </summary>
          <nav
            aria-label="Main"
            class="card absolute right-0 top-full mt-2 z-50 w-[min(17rem,calc(100vw-2.5rem))] p-1.5"
          >
            {nav.map((item) => (
              <a
                href={localePath(lang, item.href)}
                aria-current={isOn(item.href) ? 'page' : undefined}
                class:list={[
                  'block px-3.5 py-3 rounded-[12px] text-[0.9375rem] font-bold no-underline transition-colors',
                  isOn(item.href) ? 'bg-mist text-ink' : 'text-ink-2 hover:text-ink hover:bg-page',
                ]}
              >{item.label}</a>
            ))}
            <div class="h-px bg-line my-1.5 mx-3"></div>
            <a href={`tel:${tel}`} class="flex items-center gap-2.5 px-3.5 py-3 rounded-[12px] text-[0.9375rem] font-bold no-underline text-ink hover:bg-page transition-colors">
              <Icon name="phone" size={16} class="text-signal" />{site.phones[0]}
            </a>
            <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="flex items-center gap-2.5 px-3.5 py-3 rounded-[12px] text-[0.9375rem] font-bold no-underline text-ink hover:bg-page transition-colors">
              <Icon name="whatsapp" size={16} class="text-signal" />WhatsApp
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  /* The burger swaps to a close glyph while the panel is open. Written here
     rather than with a utility so the two states cannot drift apart. */
  .menu[open] .menu-open { display: none; }
  .menu[open] .menu-close { display: block; }
</style>

<script>
  // Both disclosures close on an outside click or Escape, and opening one
  // closes the other — two panels overlapping in a 56px-tall header reads as
  // a bug even when it technically works.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.lang-menu, .menu')];

  document.addEventListener('click', (e) => {
    for (const m of menus) {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    }
  });

  for (const m of menus) {
    m.addEventListener('toggle', () => {
      if (!m.open) return;
      for (const other of menus) if (other !== m) other.open = false;
    });
    m.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key !== 'Escape') return;
      m.open = false;
      m.querySelector('summary')?.focus();
    });
  }
</script>
