---
/**
 * Fixed call / WhatsApp bar for phones. Two pills on a floating card, so the
 * two things a visitor actually does from a phone are always one tap away.
 *
 * Hidden from `md` up, where the header's own call pill takes over. The body
 * reserves its height in `global.css`, including the home-indicator inset.
 */
import { getEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const tel = site.phones[0].replace(/[^+\d]/g, '');
---

<div
  class="md:hidden fixed inset-x-0 bottom-0 z-40 px-3 pt-2"
  style="padding-bottom:calc(0.75rem + env(safe-area-inset-bottom))"
>
  <div class="card flex items-center gap-2 p-2 shadow-[0_-6px_28px_rgb(24_20_80_/_0.12)]">
    <a href={`tel:${tel}`} class="pill pill-primary flex-1">
      <Icon name="phone" size={16} />{t('cta.call')}
    </a>
    <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" aria-label="WhatsApp" class="pill pill-ghost !px-4">
      <Icon name="whatsapp" size={18} />
    </a>
  </div>
</div>
