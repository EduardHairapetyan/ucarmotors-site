---
import { getEntry } from 'astro:content';
import { useTranslations, pick, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const year = new Date().getFullYear();

const social = [
  { name: 'facebook' as const, label: 'Facebook', href: site.social.facebook },
  { name: 'instagram' as const, label: 'Instagram', href: site.social.instagram },
  { name: 'linkedin' as const, label: 'LinkedIn', href: site.social.linkedin },
];
---

<footer class="mt-auto bg-wash text-ink border-t border-line">
  <div class="h-[3px]" style="background:var(--gradient-brand)" aria-hidden="true"></div>
  <div class="shell py-14 sm:py-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="flex items-center gap-2.5 font-data font-bold tracking-[0.2em] text-sm uppercase">
        <Logo size={24} />
        <span><span class="wordmark-brand">Ucar</span> <span class="text-ink-2 font-normal">Motors</span></span>
      </p>
      <p class="mt-4 text-sm leading-relaxed text-ink-2">{pick(site.address, lang)}</p>
      <a href={site.mapUrl} rel="noopener" class="inline-flex items-center gap-2 mt-3 text-sm text-ink no-underline hover:text-signal">
        <Icon name="map-pin" size={15} />{t('contact.map')}
      </a>
    </div>

    <div>
      <p class="eyebrow text-ink-2 mb-4">{t('contact.phone')}</p>
      <ul class="space-y-2">
        {site.phones.map((p) => (
          <li>
            <a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="inline-flex items-center gap-2 text-sm font-data no-underline hover:text-signal">
              <Icon name="phone" size={14} />{p}
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-sm no-underline hover:text-signal">
            <Icon name="mail" size={14} />{site.email}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow text-ink-2 mb-4">{t('contact.hours')}</p>
      <p class="text-sm text-ink-2">{pick(site.hours, lang)}</p>
      <a
        href={`https://wa.me/${site.whatsapp}`}
        rel="noopener"
        class="inline-flex items-center gap-2 mt-3 text-sm text-ink no-underline hover:text-signal"
      >
        <Icon name="whatsapp" size={16} />WhatsApp
      </a>
    </div>

    <div>
      <p class="eyebrow text-ink-2 mb-4">Social</p>
      <ul class="space-y-2 text-sm">
        {social.map((s) => (
          <li>
            <a href={s.href} rel="noopener" class="inline-flex items-center gap-2 no-underline text-ink hover:text-signal">
              <Icon name={s.name} size={16} />{s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="shell pb-8">
    <hr class="border-0 border-t border-line mb-6" />
    <p class="eyebrow text-ink-2">© {year} Ucar Motors · {t('footer.rights')}</p>
    <p class="mt-3 text-xs leading-relaxed text-ink-2 max-w-[60ch]">{t('credit.photos')}</p>
  </div>
</footer>
