---
/**
 * Footer as one card, matching the header. Display-only contact — this site
 * has no enquiry form of any kind, by the client's instruction.
 *
 * Four columns, each a `.label` heading over a left-aligned stack. No leading
 * icons on the text lines: an icon in front of one line and not the next
 * breaks the column's left edge, which is exactly the misalignment this file
 * is meant to avoid.
 */
import { getEntry } from 'astro:content';
import { localePath, useTranslations, pick, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

const nav = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];

const social = [
  { href: site.social.facebook, name: 'facebook' as const, label: 'Facebook' },
  { href: site.social.instagram, name: 'instagram' as const, label: 'Instagram' },
  { href: site.social.telegram, name: 'telegram' as const, label: 'Telegram' },
  { href: site.social.linkedin, name: 'linkedin' as const, label: 'LinkedIn' },
].filter((s): s is { href: string; name: typeof s.name; label: string } => Boolean(s.href));

const link = 'text-sm font-semibold no-underline text-ink-2 hover:text-signal transition-colors';
const linkAccent = 'text-sm font-semibold no-underline text-signal hover:text-signal-2 transition-colors';
---

<footer class="px-3 pb-3 mt-16 sm:mt-24">
  <div class="shell !px-0">
    <div class="card p-7 sm:p-10">
      <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr_1.1fr_1.3fr]">
        <div>
          <div class="flex items-center gap-2.5">
            <Logo size={26} />
            <span class="flex items-baseline gap-1.5 text-[0.9375rem] tracking-[-0.03em]">
              <span class="wordmark-brand font-extrabold">UCAR</span>
              <span class="font-bold text-ink-2">MOTORS</span>
            </span>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-ink-2 max-w-[34ch]">{t('brand.slogan')}</p>
          <div class="mt-5 flex gap-2">
            {social.map((s) => (
              <a
                href={s.href}
                rel="noopener"
                aria-label={s.label}
                class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-page text-ink-2 hover:text-signal hover:bg-mist transition-colors"
              >
                <Icon name={s.name} size={18} />
              </a>
            ))}
          </div>
        </div>

        <nav aria-label={t('footer.sections')}>
          <p class="label">{t('footer.sections')}</p>
          <ul class="mt-3 space-y-2 list-none p-0">
            {nav.map((item) => (
              <li>
                <a href={localePath(lang, item.href)} class={link}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div>
          <p class="label">{t('nav.contact')}</p>
          <ul class="mt-3 space-y-2 list-none p-0">
            {site.phones.map((p) => (
              <li><a href={`tel:${p.replace(/[^+\d]/g, '')}`} class={`font-data ${link}`}>{p}</a></li>
            ))}
            <li><a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class={linkAccent}>WhatsApp</a></li>
            <li><a href={`mailto:${site.email}`} class={link}>{site.email}</a></li>
          </ul>
        </div>

        <div>
          <p class="label">{t('contact.address')}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink-2">{pick(site.address, lang)}</p>
          <p class="mt-2 text-sm text-ink-2">{pick(site.hours, lang)}</p>
          <a href={site.mapUrl} rel="noopener" class={`inline-flex items-center gap-1.5 mt-3 ${linkAccent}`}>
            {t('contact.map')}<Icon name="external" size={13} />
          </a>
        </div>
      </div>

      <div class="mt-10 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-ink-2">© {new Date().getFullYear()} Ucar Motors · {t('footer.rights')}</p>
        <p class="text-xs text-ink-2">ՅՈՒՔԱՐ ՍՊԸ</p>
      </div>
    </div>
  </div>
</footer>
