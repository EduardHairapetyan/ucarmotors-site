---
/**
 * STOCK BOOK home: a short statement, then the book itself.
 *
 * The home page does not preview the catalogue — it *is* the catalogue. With
 * twelve cars there is nothing to gain by showing three and hiding nine, and
 * a stock list that fits on one screen is the whole argument of this
 * direction.
 */
import { getEntry } from 'astro:content';
import Card from './Card.astro';
import Icon from '../../components/Icon.astro';
import { getCars, maxRange, entryPrice } from '../../lib/catalog';
import { previewPath, useTranslations, pick, type Lang } from '../../i18n/utils';
import { priceOf } from '../../lib/catalog';

interface Props { lang: Lang; design: string }
const { lang, design } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const cars = await getCars();
const max = maxRange(cars);
const entry = entryPrice(cars);
const priced = cars.filter((c) => priceOf(c) !== null).length;

const mapSrc =
  site.mapEmbed ||
  `https://www.google.com/maps?q=${encodeURIComponent(site.address.en)}&hl=${lang}&z=15&output=embed`;

const services = [t('svc.sales'), t('svc.charging'), t('svc.warranty'), t('svc.service'), t('svc.financing')];
---

<section class="shell pt-12 pb-10 sm:pt-16">
  <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] max-w-[20ch] leading-[1.08]">{t('hero.title')}</h1>
  <p class="mt-4 text-ink-2 leading-relaxed max-w-[52ch]">{t('hero.lede')}</p>
</section>

<!-- The book. Twelve rows, three hard numbers, one gradient cap. -->
<section class="shell pb-4">
  <div class="book">
    <div class="book-cap flex flex-wrap items-baseline gap-x-7 gap-y-1 px-5 py-4">
      <span class="num font-semibold">{cars.length}</span><span class="label -ml-5 pl-5">{t('cars.count')}</span>
      <span class="num font-semibold">{priced}</span><span class="label -ml-5 pl-5">{t('car.price')}</span>
      <span class="num font-semibold">{site.financing.ratePercent}%</span><span class="label -ml-5 pl-5">{t('calc.rate')}</span>
      <span class="num font-semibold">{site.financing.maxTermYears}</span><span class="label -ml-5 pl-5">{t('calc.years')}</span>
      <a href={previewPath(design, lang, '/financing')} class="label !text-signal no-underline ml-auto">{t('nav.financing')} →</a>
    </div>

    <div class="flex flex-col" data-grid>
      {cars.map((car, i) => (
        <div data-car data-car-brand={car.data.brand}>
          <Card car={car} lang={lang} design={design} financing={site.financing} maxRange={max} index={i} />
        </div>
      ))}
    </div>
  </div>

  {entry && (
    <p class="label mt-3">
      {t('cta.from')} <span class="value text-ink">{entry.car.data.brand} {entry.car.data.model}</span> · {t('calc.note')}
    </p>
  )}
</section>

<section class="shell py-14 grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
  <div>
    <p class="label">{t('about.eyebrow')}</p>
    <h2 class="text-2xl mt-3 max-w-[22ch]">{t('about.title')}</h2>
    <p class="mt-4 text-ink-2 leading-relaxed max-w-[50ch]">{t('about.lede')}</p>
    <ul class="mt-6 grid gap-1.5 sm:grid-cols-2 text-sm text-ink-2">
      {services.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <div class="panel p-6">
    <p class="label">{t('contact.title')}</p>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      <div>
        <p class="text-sm leading-relaxed">{pick(site.address, lang)}</p>
        <p class="text-sm text-ink-2 mt-1">{pick(site.hours, lang)}</p>
        <ul class="mt-3 space-y-1">
          {site.phones.map((p) => (
            <li><a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="num no-underline hover:text-signal">{p}</a></li>
          ))}
        </ul>
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="inline-flex items-center gap-2 mt-3 text-sm no-underline text-signal">
          <Icon name="whatsapp" size={15} />WhatsApp
        </a>
      </div>
      <div class="aspect-[4/3] overflow-hidden bg-mist">
        <iframe src={mapSrc} title={pick(site.address, lang)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="w-full h-full" style="border:0"></iframe>
      </div>
    </div>
  </div>
</section>
