---
import '../../styles/global.css';
import '../../styles/preview.css';
import './theme.css';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';

import Doc from '../../components/preview/Doc.astro';
import Icon from '../../components/Icon.astro';
import { previewPath, useTranslations, pick, type Lang } from '../../i18n/utils';
import { getEntry } from 'astro:content';

interface Props {
  design: string;
  lang: Lang;
  path: string;
  page: 'home' | 'cars' | 'financing' | 'contact' | 'car';
  title?: string;
}

const { design, lang, path, page, title } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

const TITLES = {
  home: t('hero.title'),
  cars: t('cars.title'),
  financing: t('fin.title'),
  contact: t('contact.title'),
  car: title ?? '',
} as const;

const nav = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];
---

<Doc design={design} lang={lang} path={path} title={title ?? TITLES[page]} description={t('hero.lede')}>
  <header slot="header" class="bg-white">
    <div class="shell flex items-center gap-6 h-14">
      <a href={previewPath(design, lang, '/')} class="no-underline font-semibold tracking-[-0.02em]">
        Ucar<span class="text-ink-2 font-normal"> Motors</span>
      </a>

      <nav aria-label="Main" class="hs flex items-center gap-6 ml-auto overflow-x-auto">
        {nav.map((item) => (
          <a
            href={previewPath(design, lang, item.href)}
            aria-current={path === item.href ? 'page' : undefined}
            class:list={[
              'text-sm no-underline whitespace-nowrap transition-colors',
              path === item.href ? 'text-signal font-medium' : 'text-ink-2 hover:text-ink',
            ]}
          >{item.label}</a>
        ))}
      </nav>

      <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="hidden sm:inline-flex items-center gap-2 label !text-white bg-signal px-3.5 py-2.5 no-underline hover:bg-signal-2 transition-colors">
        <Icon name="phone" size={13} />{t('cta.call')}
      </a>
    </div>
  </header>

  <slot />

  <footer slot="footer" class="mt-20 bg-white">
    <div class="shell py-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="label">{t('contact.address')}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-2">{pick(site.address, lang)}</p>
      </div>
      <div>
        <p class="label">{t('contact.hours')}</p>
        <p class="mt-2 text-sm text-ink-2">{pick(site.hours, lang)}</p>
      </div>
      <div>
        <p class="label">{t('contact.phone')}</p>
        <ul class="mt-2 space-y-1">
          {site.phones.map((p) => (
            <li><a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="num no-underline hover:text-signal">{p}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="label">Ucar Motors</p>
        <div class="mt-2 flex gap-3 text-ink-2">
          <a href={site.social.facebook} rel="noopener" aria-label="Facebook" class="hover:text-signal"><Icon name="facebook" size={17} /></a>
          <a href={site.social.instagram} rel="noopener" aria-label="Instagram" class="hover:text-signal"><Icon name="instagram" size={17} /></a>
          <a href={site.social.linkedin} rel="noopener" aria-label="LinkedIn" class="hover:text-signal"><Icon name="linkedin" size={17} /></a>
        </div>
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="inline-flex items-center gap-2 mt-4 text-sm no-underline text-ink-2 hover:text-signal">
          <Icon name="whatsapp" size={15} />WhatsApp
        </a>
      </div>
    </div>
    <div class="shell pb-8 label">© {new Date().getFullYear()} Ucar Motors · {t('footer.rights')}</div>
  </footer>
</Doc>
