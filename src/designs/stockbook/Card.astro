---
/**
 * STOCK BOOK's unit of catalogue is a row, not a card.
 *
 * A blank cell is a normal thing in a price list — it reads as "not stated
 * yet", not as a broken component — which is why this direction survives a
 * catalogue where nine of twelve cars have no published price.
 *
 * The row at index 0 also emits the column header and the sort behaviour, so
 * the shared `preview/Cars.astro` does not need to know it is drawing a
 * table.
 */
import PaymentCalculator from '../../components/PaymentCalculator.astro';
import CarSilhouette from '../../components/CarSilhouette.astro';
import { getEntry } from 'astro:content';
import { previewPath, asset, formatAmd, monthlyPayment, useTranslations, pick, type Lang } from '../../i18n/utils';
import { priceOf, type Car } from '../../lib/catalog';

interface Props {
  car: Car;
  lang: Lang;
  design: string;
  financing: any;
  maxRange: number;
  index?: number;
}

const { car, lang, design, financing: f, index = 0 } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const d = car.data;

const name = [d.brand, d.model].join(' ');
const href = previewPath(design, lang, `/cars/${car.id}`);
const price = priceOf(car);
const monthly = price ? monthlyPayment(price, f.defaultDownPercent, f.defaultTermYears, f.ratePercent) : null;
const blurb = pick(d.description, lang);

const COLS = [
  { key: 'name', label: t('filter.brand'), cls: '' },
  { key: 'status', label: t('filter.status'), cls: '' },
  { key: 'price', label: t('car.price'), cls: 'text-right' },
  { key: 'monthly', label: t('calc.perMonth'), cls: 'text-right' },
];
---

{index === 0 && (
  <div class="row row-head" data-sortbar>
    <span></span>
    {COLS.map((c) => (
      <button type="button" class={`sortbtn label ${c.cls}`} data-sort={c.key} aria-pressed="false">
        {c.label} <span aria-hidden="true">↕</span>
      </button>
    ))}
    <span></span>
  </div>
)}

<details
  class="block"
  data-price={price ?? ''}
  data-monthly={monthly ?? ''}
  data-name={name}
  data-status={d.status}
>
  <summary class="row" aria-label={name}>
    <span class="row-thumb block">
      {d.images.length > 0
        ? <img src={asset(d.images[0])} alt="" loading="lazy" decoding="async" width="180" height="112" />
        : <CarSilhouette body={d.bodyType} class="w-full h-full" />}
    </span>

    <span class="row-name block min-w-0">
      <span class="block font-medium leading-tight truncate">{name}</span>
      {d.year && <span class="label">{d.year}</span>}
    </span>

    <span class="row-meta label !text-ink-2">
      {t(`status.${d.status}` as 'status.available')}
      {d.rangeKm && <span class="hidden lg:inline"> · {d.rangeKm} km</span>}
    </span>

    <span class="row-price num text-right">
      {price !== null ? `${formatAmd(price, lang)} ֏` : '—'}
    </span>

    <span class="row-money num text-right font-semibold">
      {monthly !== null
        ? <span>{formatAmd(monthly, lang)}<span class="text-ink-2 font-normal"> {t('calc.perMonth')}</span></span>
        : <span class="text-signal">{t('cta.call')}</span>}
    </span>

    <span class="caret text-ink-2 justify-self-end" aria-hidden="true">▾</span>
  </summary>

  <!-- The signature: the row opens into its own calculator, so three cars can
       be compared on monthly payment without ever leaving the list. -->
  <div class="drawer">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr] max-w-4xl">
      <div>
        {blurb
          ? <p class="text-sm leading-relaxed text-ink-2 max-w-[52ch]">{blurb}</p>
          : <p class="text-sm text-ink-2">{t('car.specsPending')}</p>}
        <a href={href} class="inline-block mt-5 label !text-signal no-underline">{name} →</a>
      </div>

      <div>
        <p class="label mb-3">{t('calc.title')}</p>
        {price !== null ? (
          <PaymentCalculator price={price} financing={site.financing} lang={lang} size="sm" tone="light" id={`row-${car.id}`} />
        ) : (
          <p class="text-sm text-ink-2 max-w-[40ch]">
            {t('car.onRequest')} —
            <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="text-signal no-underline"> {site.phones[0]}</a>
          </p>
        )}
      </div>
    </div>
  </div>
</details>

<script>
    // Sort the rows in place. Unpriced cars always sink to the bottom rather
    // than being treated as zero — "not stated" is not "cheapest".
    const bar = document.querySelector<HTMLElement>('[data-sortbar]');
    const grid = bar?.closest('[data-grid]') as HTMLElement | null;
    if (bar && grid) {
      // The header is authored inside the first row's wrapper (the shared
      // catalogue component only knows how to emit cards). Lift it out to be
      // a sibling first, or sorting would carry it around with that car.
      grid.insertBefore(bar, grid.firstChild);

      const rows = () => [...grid.querySelectorAll<HTMLElement>('[data-car]')];
      let active = '';
      let asc = true;

      const value = (el: HTMLElement, key: string) => {
        const d = el.querySelector<HTMLElement>('details');
        if (!d) return '';
        if (key === 'name') return d.dataset.name ?? '';
        if (key === 'status') return d.dataset.status ?? '';
        return d.dataset[key as 'price' | 'monthly'] ?? '';
      };

      bar.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.sort!;
          asc = key === active ? !asc : true;
          active = key;

          bar.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn))
          );

          const numeric = key === 'price' || key === 'monthly';
          const sorted = rows().sort((a, b) => {
            const va = value(a, key);
            const vb = value(b, key);
            if (numeric) {
              // Empty sinks, in both directions.
              if (!va && !vb) return 0;
              if (!va) return 1;
              if (!vb) return -1;
              return (Number(va) - Number(vb)) * (asc ? 1 : -1);
            }
            return va.localeCompare(vb) * (asc ? 1 : -1);
          });

          sorted.forEach((r) => grid.appendChild(r));
        });
      });
    }
</script>
