---
import '../../styles/global.css';
import '../../styles/preview.css';
import './theme.css';
import '@fontsource-variable/manrope';

import Doc from '../../components/preview/Doc.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import { previewPath, useTranslations, pick, type Lang } from '../../i18n/utils';
import { getEntry } from 'astro:content';

interface Props {
  design: string;
  lang: Lang;
  path: string;
  page: 'home' | 'cars' | 'financing' | 'contact' | 'car';
  title?: string;
}

const { design, lang, path, page, title } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

const TITLES = {
  home: t('hero.title'),
  cars: t('cars.title'),
  financing: t('fin.title'),
  contact: t('contact.title'),
  car: title ?? '',
} as const;

const nav = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];
---

<Doc design={design} lang={lang} path={path} title={title ?? TITLES[page]} description={t('hero.lede')}>
  <!-- The header floats: a rounded bar sitting on the page rather than a band
       ruled off from it. Same radius as everything else. -->
  <header slot="header" class="sticky top-[38px] z-30 px-3 pt-3">
    <div class="shell !max-w-[80rem] !px-0">
      <div class="card flex items-center gap-4 px-4 sm:px-6 h-14 sm:h-16">
        <a href={previewPath(design, lang, '/')} class="no-underline flex items-center gap-2.5 shrink-0">
          <Logo size={24} />
          <span class="font-bold tracking-[-0.03em]">Ucar Motors</span>
        </a>

        <nav aria-label="Main" class="hs flex items-center gap-1 ml-auto overflow-x-auto">
          {nav.map((item) => (
            <a
              href={previewPath(design, lang, item.href)}
              aria-current={path === item.href ? 'page' : undefined}
              class:list={[
                'px-3.5 py-2 rounded-full text-sm font-semibold no-underline whitespace-nowrap transition-colors',
                path === item.href ? 'bg-mist text-ink' : 'text-ink-2 hover:text-ink',
              ]}
            >{item.label}</a>
          ))}
        </nav>

        <!-- Wrapped rather than carrying `hidden` itself: `.pill` sets its own
             display outside Tailwind's layers and would win over the utility,
             leaving the phone header with a call button and no navigation. -->
        <span class="hidden sm:block shrink-0">
          <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="pill pill-call !min-h-[2.25rem] !text-sm">
            <Icon name="phone" size={14} />{t('cta.call')}
          </a>
        </span>
      </div>
    </div>
  </header>

  <slot />

  <footer slot="footer" class="px-3 pb-3 mt-20">
    <div class="shell !max-w-[80rem] !px-0">
      <div class="card p-8 sm:p-10">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-2">
            <div class="flex items-center gap-2.5">
              <Logo size={24} />
              <span class="font-bold tracking-[-0.03em]">Ucar Motors</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-ink-2 max-w-[34ch]">{pick(site.address, lang)}</p>
            <p class="text-sm text-ink-2">{pick(site.hours, lang)}</p>
          </div>

          <div>
            <p class="label">{t('contact.phone')}</p>
            <ul class="mt-2.5 space-y-1.5">
              {site.phones.map((p) => (
                <li><a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="text-sm no-underline hover:text-signal">{p}</a></li>
              ))}
            </ul>
            <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="inline-flex items-center gap-2 mt-3 text-sm no-underline text-signal">
              <Icon name="whatsapp" size={15} />WhatsApp
            </a>
          </div>

          <div>
            <p class="label">Ucar Motors</p>
            <div class="mt-2.5 flex gap-2">
              <a href={site.social.facebook} rel="noopener" aria-label="Facebook" class="p-2.5 rounded-full bg-wash text-ink-2 hover:text-signal transition-colors"><Icon name="facebook" size={17} /></a>
              <a href={site.social.instagram} rel="noopener" aria-label="Instagram" class="p-2.5 rounded-full bg-wash text-ink-2 hover:text-signal transition-colors"><Icon name="instagram" size={17} /></a>
              <a href={site.social.linkedin} rel="noopener" aria-label="LinkedIn" class="p-2.5 rounded-full bg-wash text-ink-2 hover:text-signal transition-colors"><Icon name="linkedin" size={17} /></a>
            </div>
          </div>
        </div>

        <p class="mt-8 text-xs text-ink-2">© {new Date().getFullYear()} Ucar Motors · {t('footer.rights')}</p>
      </div>
    </div>
  </footer>
</Doc>
