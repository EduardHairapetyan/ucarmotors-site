---
/**
 * DAYLIGHT's tile.
 *
 * The bottom row is always a pill of the same shape, size and position: the
 * monthly figure when the price is published, the call action when it is
 * not. Nine of twelve cars have no price, and none of them should look like
 * a card that failed to load.
 */
import CarSilhouette from '../../components/CarSilhouette.astro';
import { getEntry } from 'astro:content';
import { previewPath, asset, formatAmd, monthlyPayment, useTranslations, pick, type Lang } from '../../i18n/utils';
import { priceOf, type Car } from '../../lib/catalog';

interface Props {
  car: Car;
  lang: Lang;
  design: string;
  financing: any;
  maxRange: number;
  index?: number;
}

const { car, lang, design, financing: f, index = 0 } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const d = car.data;

const name = [d.brand, d.model].join(' ');
const href = previewPath(design, lang, `/cars/${car.id}`);
const price = priceOf(car);
const monthly = price ? monthlyPayment(price, f.defaultDownPercent, f.defaultTermYears, f.ratePercent) : null;
const blurb = pick(d.description, lang);
---

<article class="card h-full flex flex-col p-3 rise" style={`--d:${Math.min(index, 5) * 70}ms`} data-reveal>
  <a href={href} class="inset aspect-[16/10] block no-underline">
    {d.images.length > 0
      ? <img src={asset(d.images[0])} alt={name} loading="lazy" decoding="async" width="640" height="400" class="w-full h-full object-cover" />
      : <CarSilhouette body={d.bodyType} class="w-full h-full" />}
  </a>

  <div class="flex flex-col flex-1 px-3 pt-4 pb-3">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-[1.0625rem] leading-tight">
        <a href={href} class="no-underline">{name}</a>
      </h3>
      {d.year && <span class="text-sm text-ink-2 shrink-0">{d.year}</span>}
    </div>

    <p class:list={['status mt-2', d.status === 'available' && 'status-available']}>
      {t(`status.${d.status}` as 'status.available')}
      {d.rangeKm && <span class="text-ink-2 font-normal">· {d.rangeKm} km</span>}
    </p>

    {blurb && <p class="mt-3 text-sm leading-relaxed text-ink-2 line-clamp-2">{blurb}</p>}

    <!-- Always the same shape. -->
    <div class="mt-auto pt-5">
      {monthly !== null ? (
        <a href={href} class="pill pill-money w-full">
          <b>{formatAmd(monthly, lang)}</b>
          <span class="text-ink-2 font-medium">{t('calc.perMonth')}</span>
        </a>
      ) : (
        <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="pill pill-call w-full">{t('cta.call')}</a>
      )}
    </div>
  </div>
</article>
