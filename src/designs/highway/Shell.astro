---
import '../../styles/global.css';
import '../../styles/preview.css';
import './theme.css';
import '@fontsource-variable/geologica';
import '@fontsource-variable/golos-text';

import Doc from '../../components/preview/Doc.astro';
import Icon from '../../components/Icon.astro';
import { previewPath, useTranslations, pick, type Lang } from '../../i18n/utils';
import { getEntry } from 'astro:content';

interface Props {
  design: string;
  lang: Lang;
  path: string;
  page: 'home' | 'cars' | 'financing' | 'contact' | 'car';
  title?: string;
}

const { design, lang, path, page, title } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

const TITLES = {
  home: t('hero.title'),
  cars: t('cars.title'),
  financing: t('fin.title'),
  contact: t('contact.title'),
  car: title ?? '',
} as const;

const nav = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];
---

<Doc design={design} lang={lang} path={path} title={title ?? TITLES[page]} description={t('hero.lede')}>
  <header slot="header" class="bg-white">
    <div class="shell flex items-center gap-6 h-16">
      <a href={previewPath(design, lang, '/')} class="no-underline">
        <span class="display text-[0.9375rem] tracking-[0.1em]">Ucar Motors</span>
      </a>

      <nav aria-label="Main" class="hs flex items-center gap-6 ml-auto overflow-x-auto">
        {nav.map((item) => (
          <a
            href={previewPath(design, lang, item.href)}
            aria-current={path === item.href ? 'page' : undefined}
            class:list={[
              'label no-underline whitespace-nowrap transition-colors hover:!text-ink',
              path === item.href && '!text-ink',
            ]}
          >{item.label}</a>
        ))}
      </nav>

      <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="hidden sm:inline-flex items-center gap-2 label !text-white bg-ink px-4 py-3 no-underline hover:bg-signal transition-colors">
        <Icon name="phone" size={13} />{t('cta.call')}
      </a>
    </div>
  </header>

  <slot />

  <!-- The footer is the second sign: the address as a destination, set in the
       same voice as the hero. -->
  <footer slot="footer" class="mt-24 bg-ink text-white">
    <div class="shell py-16">
      <p class="display text-[clamp(1.5rem,4vw,2.5rem)] text-white max-w-[18ch]">{pick(site.address, lang)}</p>

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 border-t border-white/15 pt-8">
        <div>
          <p class="label !text-white/40">{t('contact.hours')}</p>
          <p class="mt-2 text-sm text-white/80">{pick(site.hours, lang)}</p>
        </div>
        <div>
          <p class="label !text-white/40">{t('contact.phone')}</p>
          <ul class="mt-2 space-y-1">
            {site.phones.map((p) => (
              <li><a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="font-data text-sm no-underline text-white/85 hover:text-white">{p}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="label !text-white/40">Email</p>
          <a href={`mailto:${site.email}`} class="mt-2 inline-block text-sm no-underline text-white/85 hover:text-white">{site.email}</a>
          <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="flex items-center gap-2 mt-3 text-sm no-underline text-white/85 hover:text-white">
            <Icon name="whatsapp" size={15} />WhatsApp
          </a>
        </div>
        <div>
          <p class="label !text-white/40">Ucar Motors</p>
          <div class="mt-2 flex gap-3 text-white/60">
            <a href={site.social.facebook} rel="noopener" aria-label="Facebook" class="hover:text-white"><Icon name="facebook" size={18} /></a>
            <a href={site.social.instagram} rel="noopener" aria-label="Instagram" class="hover:text-white"><Icon name="instagram" size={18} /></a>
            <a href={site.social.linkedin} rel="noopener" aria-label="LinkedIn" class="hover:text-white"><Icon name="linkedin" size={18} /></a>
          </div>
        </div>
      </div>

      <p class="mt-10 label !text-white/30">© {new Date().getFullYear()} Ucar Motors · {t('footer.rights')}</p>
    </div>
  </footer>
</Doc>
