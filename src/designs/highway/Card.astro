---
/**
 * HIGHWAY SIGN has no card. A car is a line in an index: brand small, model
 * large, and one figure at the end of the row.
 *
 * When there is no published price the right-hand slot carries the word
 * instead of the number, set in the same face at the same size — the
 * composition never changes, only the content of the slot.
 */
import { previewPath, asset, formatAmd, monthlyPayment, useTranslations, type Lang } from '../../i18n/utils';
import { priceOf, type Car } from '../../lib/catalog';

interface Props {
  car: Car;
  lang: Lang;
  design: string;
  financing: any;
  maxRange: number;
  index?: number;
}

const { car, lang, design, financing: f, index = 0 } = Astro.props;
const t = useTranslations(lang);
const d = car.data;

const href = previewPath(design, lang, `/cars/${car.id}`);
const price = priceOf(car);
const monthly = price ? monthlyPayment(price, f.defaultDownPercent, f.defaultTermYears, f.ratePercent) : null;
const bleed = d.images.length > 0 ? asset(d.images[0]) : null;
---

<a href={href} class="idx no-underline group" data-reveal style={`--reveal-delay:${Math.min(index, 6) * 45}ms`}>
  {bleed && <span class="idx-bleed" style={`background-image:url(${bleed})`} aria-hidden="true"></span>}

  <span class="block aspect-[16/10] overflow-hidden bg-mist">
    {bleed && <img src={bleed} alt="" loading="lazy" decoding="async" width="160" height="100" class="w-full h-full object-cover" />}
  </span>

  <span class="block min-w-0">
    <span class="idx-brand block">{d.brand}</span>
    <span class="idx-model block mt-1">{d.model}{d.year && <span class="text-ink-2"> {d.year}</span>}</span>
    <span class="label block mt-2">
      {t(`status.${d.status}` as 'status.available')}{d.rangeKm && ` · ${d.rangeKm} km`}
    </span>
  </span>

  <span class="idx-money">
    {monthly !== null ? (
      <>{formatAmd(monthly, lang)}<span class="text-ink-2 font-normal"> {t('calc.perMonth')}</span></>
    ) : (
      <span class="text-signal">{t('car.onRequest')}</span>
    )}
    <span class="text-ink-2 ml-2" aria-hidden="true">→</span>
  </span>
</a>
