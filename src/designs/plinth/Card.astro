---
/**
 * PLINTH's unit of catalogue is not a card but a band: one car across the
 * full measure, plate on one side, facts on the other, sides alternating
 * down the page so the eye has to move.
 *
 * Nothing but the name and the plate has a reserved slot. Nine of the twelve
 * cars have no price, no range and no description; a band for one of those
 * simply has fewer lines, not a hole where a component should be.
 */
import CarSilhouette from '../../components/CarSilhouette.astro';
import { previewPath, asset, formatAmd, monthlyPayment, useTranslations, pick, type Lang } from '../../i18n/utils';
import { priceOf, type Car } from '../../lib/catalog';

interface Props {
  car: Car;
  lang: Lang;
  design: string;
  financing: { ratePercent: number; defaultDownPercent: number; defaultTermYears: number };
  maxRange: number;
  index?: number;
}

const { car, lang, design, financing: f, index = 0 } = Astro.props;
const t = useTranslations(lang);
const d = car.data;

const name = [d.brand, d.model].join(' ');
const href = previewPath(design, lang, `/cars/${car.id}`);
const price = priceOf(car);
const monthly = price ? monthlyPayment(price, f.defaultDownPercent, f.defaultTermYears, f.ratePercent) : null;
const blurb = pick(d.description, lang);
const flip = index % 2 === 1;
---

<article class="border-t border-line py-14 sm:py-20" data-reveal>
  <div class="shell grid gap-8 lg:gap-16 lg:grid-cols-2 lg:items-center">
    <a
      href={href}
      class:list={['plate aspect-[16/9] block no-underline', flip && 'lg:order-2']}
      aria-hidden="true"
      tabindex="-1"
    >
      {d.images.length > 0
        ? <img src={asset(d.images[0])} alt="" loading="lazy" decoding="async" width="960" height="540" />
        : <CarSilhouette body={d.bodyType} class="w-full h-full" />}
    </a>

    <div class={flip ? 'lg:order-1' : ''}>
      <p class="label">{String(index + 1).padStart(2, '0')} / {t(`status.${d.status}` as 'status.available')}</p>

      <h2 class="display text-[clamp(1.75rem,3.6vw,2.75rem)] mt-4">
        <a href={href} class="no-underline">{name}</a>
        {d.year && <span class="text-ink-2"> {d.year}</span>}
      </h2>

      {blurb && <p class="mt-5 leading-relaxed text-ink-2 max-w-[46ch]">{blurb}</p>}

      {d.rangeKm && (
        <p class="mt-5 font-data text-sm text-ink-2">
          {d.rangeKm} km <span class="text-dim">· {t('car.range')}</span>
        </p>
      )}

      <!-- The price is a caption under a photograph, so its absent state is a
           sentence rather than a gap. -->
      <div class="mt-7">
        {price !== null ? (
          <>
            <p class="payment text-[2rem] leading-none">
              {formatAmd(price, lang)}<span class="text-base text-ink-2 font-medium"> ֏</span>
            </p>
            {monthly !== null && (
              <p class="label mt-2">{t('cta.from')} <span class="value text-ink">{formatAmd(monthly, lang)}</span> {t('calc.perMonth')}</p>
            )}
          </>
        ) : (
          <p class="display text-[1.375rem] text-ink-2">{t('car.onRequest')}</p>
        )}
      </div>

      <a href={href} class="link inline-block mt-8">{t('car.specs')} →</a>
    </div>
  </div>
</article>
