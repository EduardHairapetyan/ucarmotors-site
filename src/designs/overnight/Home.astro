---
/**
 * OVERNIGHT home: dusk, then daylight.
 *
 * The hero is the only dark band on the page — the catalogue below it is
 * white. The rail lives in the Shell, so it is already on screen before the
 * first scroll and stays there through every other page.
 */
import { getEntry } from 'astro:content';
import Card from './Card.astro';
import CarSilhouette from '../../components/CarSilhouette.astro';
import Icon from '../../components/Icon.astro';
import { getCars, getFeatured, maxRange, entryPrice, priceOf } from '../../lib/catalog';
import { previewPath, asset, useTranslations, pick, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; design: string }
const { lang, design } = Astro.props;
const t = useTranslations(lang);

const site = (await getEntry('settings', 'site'))!.data;
const f = site.financing;
const cars = await getCars();
const featured = await getFeatured(3);
const max = maxRange(cars);
const entry = entryPrice(cars);

const heroCar = entry?.car ?? featured[0]!;
const heroName = `${heroCar.data.brand} ${heroCar.data.model}`;
const heroPrice = entry?.price ?? priceOf(heroCar);

const services = [t('svc.sales'), t('svc.charging'), t('svc.warranty'), t('svc.service'), t('svc.financing')];
---

<section class="dusk relative overflow-hidden">
  <div
    class="pointer-events-none absolute -top-56 -right-40 h-[46rem] w-[46rem] rounded-full opacity-30 blur-3xl"
    style="background:var(--gradient-brand)"
    aria-hidden="true"
  ></div>

  <div class="shell relative py-14 sm:py-20 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16 lg:items-center">
      <div>
        <h1 class="text-white text-[clamp(2rem,5vw,3.5rem)] leading-[1.05] max-w-[15ch]">{t('hero.title')}</h1>
        <p class="mt-6 text-white/65 leading-relaxed max-w-[42ch]">{t('hero.lede')}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href={previewPath(design, lang, '/cars')} class="btn btn-primary">{t('nav.cars')}</a>
          <a href={`tel:${site.phones[0].replace(/[^+\d]/g, '')}`} class="btn btn-on-dark">
            <Icon name="phone" size={15} />{t('cta.call')}
          </a>
        </div>

        <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/12 pt-6">
          <div>
            <dt class="label">{t('cars.count')}</dt>
            <dd class="font-data text-white text-2xl font-bold mt-1">{cars.length}</dd>
          </div>
          <div>
            <dt class="label">{t('calc.rate')}</dt>
            <dd class="font-data text-white text-2xl font-bold mt-1">{f.ratePercent}%</dd>
          </div>
          <div>
            <dt class="label">{t('calc.term')}</dt>
            <dd class="font-data text-white text-2xl font-bold mt-1">{f.maxTermYears} {t('calc.years')}</dd>
          </div>
        </dl>
      </div>

      <div>
        <a href={previewPath(design, lang, `/cars/${heroCar.id}`)} class="block no-underline rounded-md overflow-hidden ring-1 ring-white/12">
          <div class="aspect-[16/10]" style="background:var(--dusk-2)">
            {heroCar.data.images.length > 0
              ? <img src={asset(heroCar.data.images[0])} alt={heroName} width="960" height="600" class="w-full h-full object-cover" />
              : <CarSilhouette body={heroCar.data.bodyType} class="w-full h-full" />}
          </div>
        </a>

        <div class="flex flex-wrap items-center justify-between gap-3 mt-4">
          <div>
            <p class="text-white font-[var(--font-display)] font-bold text-lg">{heroName}</p>
            <p class="label">{t(`status.${heroCar.data.status}` as 'status.available')}</p>
          </div>
          {heroPrice !== null && (
            <button type="button" class="loadbtn !text-white/70 hover:!text-white" data-load-price={heroPrice} data-load-name={heroName}>
              ▸ {t('calc.title')}
            </button>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="shell py-16 sm:py-20">
  <div class="flex items-end justify-between gap-4 flex-wrap border-b border-line pb-5">
    <h2 class="text-[clamp(1.375rem,2.6vw,1.875rem)]">{t('cars.title')}</h2>
    <a href={previewPath(design, lang, '/cars')} class="label !text-signal no-underline">{t('cta.viewAll')} →</a>
  </div>

  <p class="label mt-5">{t('calc.note')}</p>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mt-6">
    {featured.map((car, i) => (
      <Card car={car} lang={lang} design={design} financing={f} maxRange={max} index={i} />
    ))}
  </div>
</section>

<section class="bg-mist border-y border-line">
  <div class="shell py-16 grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16" data-reveal>
    <div>
      <p class="label">{t('about.eyebrow')}</p>
      <h2 class="text-[clamp(1.375rem,2.6vw,1.875rem)] mt-3 max-w-[20ch]">{t('about.title')}</h2>
      <p class="mt-4 leading-relaxed text-ink-2 max-w-[48ch]">{t('about.lede')}</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 self-center">
      {services.map((s) => (
        <li class="flex items-center gap-3 text-sm">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-charge-lift shrink-0"></span>{s}
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="shell py-16 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end" data-reveal>
  <div>
    <h2 class="text-[clamp(1.375rem,2.6vw,1.875rem)] max-w-[18ch]">{t('contact.title')}</h2>
    <p class="mt-4 text-ink-2 leading-relaxed max-w-[40ch]">{pick(site.address, lang)} · {pick(site.hours, lang)}</p>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href={previewPath(design, lang, '/contact')} class="btn btn-primary">{t('nav.contact')}</a>
    <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn btn-on-light">
      <Icon name="whatsapp" size={16} />WhatsApp
    </a>
  </div>
</section>
