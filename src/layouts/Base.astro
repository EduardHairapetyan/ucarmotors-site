---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { getEntry } from 'astro:content';
import { localePath, stripLocale, useTranslations, pick, asset, type Lang } from '../i18n/utils';
import { htmlLang, locales } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Extra JSON-LD to merge into the page graph — one node or several. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Pages that exist at every URL rather than at one — the 404. They get no
   * canonical and no hreflang, because there is no `/ru/404` or `/en/404` to
   * point at and advertising them sends crawlers to dead addresses.
   */
  noindex?: boolean;
}

const { lang, title, description, schema, noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;

const bare = stripLocale(Astro.url.pathname);
const canonical = new URL(localePath(lang, bare), Astro.site).href;
const fullTitle = `${title} · Ucar Motors`;

// Site root including the deploy base — the identity every page shares.
const siteHref = new URL(import.meta.env.BASE_URL, Astro.site).href;
const dealerId = `${siteHref}#dealer`;

const dealer = {
  '@type': 'AutoDealer',
  '@id': dealerId,
  name: 'Ucar Motors',
  description,
  email: site.email,
  telephone: site.phones,
  url: siteHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: pick(site.address, 'en'),
    addressRegion: 'Kotayk',
    addressCountry: 'AM',
  },
  sameAs: [site.social.facebook, site.social.instagram, site.social.linkedin, site.social.telegram].filter(Boolean),
};

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const graph = { '@context': 'https://schema.org', '@graph': [dealer, ...extra] };
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F4F5FB" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {!noindex && locales.map((code) => (
      <link rel="alternate" hreflang={htmlLang[code]} href={new URL(localePath(code, bare), Astro.site).href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(localePath('hy', bare), Astro.site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ucar Motors" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={htmlLang[lang].replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:px-4 focus:py-2 focus:bg-signal focus:text-white"
    >{t('skip')}</a>

    <Header lang={lang} langTarget={noindex ? '/' : undefined} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer lang={lang} />
    <MobileActionBar lang={lang} />

    <script>
      // Reveal elements as they scroll into view. Anything still off-screen
      // when this runs starts hidden (CSS); everything else is shown at once.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (still || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        // Anything already on screen is shown outright. A scroll-reveal is for
        // content you scroll to; running it on the first section leaves the top
        // of the page briefly blank, and the observer can be slow to settle
        // while lazy images are still reflowing underneath it.
        const pending: HTMLElement[] = [];
        for (const el of els) {
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
          else pending.push(el);
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          },
          // threshold 0: a tall section only shows a thin slice before it
          // should appear, and a ratio threshold would hold it back.
          { rootMargin: '0px 0px -6% 0px', threshold: 0 }
        );
        pending.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
