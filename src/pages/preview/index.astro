---
/**
 * The chooser. Five proposals, each openable in the language you want to
 * judge it in. Intentionally unstyled by any of the designs — it is the
 * contact sheet, not one of the photographs.
 */
import '../../styles/global.css';
import { designs } from '../../designs/registry';
import { previewPath } from '../../i18n/utils';
import { locales } from '../../i18n/ui';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Design proposals · Ucar Motors</title>
    <style>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        background: #0B0C10;
        color: #fff;
        font-family: "Inter Variable", system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 80rem; margin-inline: auto; padding: 4rem 1.5rem 6rem; }
      .lede { max-width: 46ch; color: #9AA1AB; line-height: 1.65; margin: 1.25rem 0 0; }
      h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); letter-spacing: -0.03em; margin: 0.75rem 0 0; }
      .kicker {
        font-family: ui-monospace, monospace;
        font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: #7DE3D8;
        margin: 0;
      }
      .grid { display: grid; gap: 1.25rem; margin-top: 3.5rem; }
      @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 72rem) { .grid { grid-template-columns: repeat(3, 1fr); } }

      .card {
        display: flex; flex-direction: column;
        border: 1px solid #23262E;
        background: #12141A;
        transition: border-color 140ms ease, transform 140ms ease;
      }
      .card:hover { border-color: #3D424D; transform: translateY(-2px); }
      .swatches { display: flex; height: 5.5rem; }
      .swatches i { flex: 1; }
      .body { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
      .num { font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: 0.2em; color: #6D737D; }
      .name { font-size: 1.375rem; letter-spacing: -0.02em; margin: 0; }
      .tag { color: #C3C8D0; line-height: 1.5; margin: 0; font-size: 0.9375rem; }
      ul { margin: 0.25rem 0 0; padding-left: 1.05rem; color: #8A9099; font-size: 0.8125rem; line-height: 1.7; }
      .go { margin-top: auto; padding-top: 1.25rem; display: flex; align-items: center; gap: 0.5rem; }
      .go a {
        font-family: ui-monospace, monospace; font-size: 11px; letter-spacing: 0.12em;
        text-transform: uppercase; text-decoration: none;
        padding: 0.625rem 0.875rem; border: 1px solid #2E323B; color: #fff;
        transition: background-color 120ms ease, border-color 120ms ease;
      }
      .go a:hover { background: #fff; color: #0B0C10; border-color: #fff; }
      .go a.main { background: #3B4EE6; border-color: #3B4EE6; }
      .go a.main:hover { background: #fff; }
      footer { margin-top: 4rem; color: #6D737D; font-size: 0.8125rem; line-height: 1.7; max-width: 60ch; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <p class="kicker">Ucar Motors · design review</p>
      <h1>Five directions, one catalogue.</h1>
      <p class="lede">
        The same cars, prices and three languages, rebuilt five ways. Open any one and
        move around it — the bar at the top switches directions without losing your place.
        Pick the one to keep; the rest get deleted.
      </p>

      <div class="grid">
        {designs.map((d, i) => (
          <article class="card">
            <div class="swatches" aria-hidden="true">
              {d.swatches.map((c) => <i style={`background:${c}`}></i>)}
            </div>
            <div class="body">
              <p class="num">{String(i + 1).padStart(2, '0')} — {d.id}</p>
              <h2 class="name">{d.name}</h2>
              <p class="tag">{d.tagline}</p>
              <ul>{d.notes.map((n) => <li>{n}</li>)}</ul>
              <div class="go">
                <a class="main" href={previewPath(d.id, 'hy')}>Open</a>
                {locales.filter((l) => l !== 'hy').map((l) => (
                  <a href={previewPath(d.id, l)}>{l}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>

      <footer>
        Preview only — noindex, excluded from the sitemap, and separate from the live
        site, which is untouched at its own URLs. Prices still obey the verification
        gate, so unverified cars read “price on request” in every direction.
      </footer>
    </div>
  </body>
</html>
