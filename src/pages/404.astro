---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getEntry } from 'astro:content';
import { localePath, useTranslations, getLangFromUrl } from '../i18n/utils';

// One 404 is served for every unknown path, so the locale cannot be known at
// build time. It leads in Armenian and repeats the headline in the other two,
// then offers every section rather than making the visitor guess.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = (await getEntry('settings', 'site'))!.data;
const tel = site.phones[0].replace(/[^+\d]/g, '');

const links = [
  { href: '/cars', label: t('nav.cars') },
  { href: '/financing', label: t('nav.financing') },
  { href: '/contact', label: t('nav.contact') },
];
---

<Base lang={lang} title="404" description="Page not found" noindex>
  <section class="shell py-12 sm:py-20">
    <div class="relative overflow-hidden card p-10 sm:p-16 max-w-2xl mx-auto text-center">
      <div class="spill -top-32 left-1/2 -translate-x-1/2 h-64 w-[28rem]" aria-hidden="true"></div>
      <div class="relative">
        <p class="payment text-6xl sm:text-7xl text-signal">404</p>
        <h1 class="text-title mt-5">Էջը չգտնվեց</h1>
        <p class="mt-3 text-ink-2">Страница не найдена · Page not found</p>

        <div class="mt-9 flex flex-wrap justify-center gap-3">
          {links.map((l) => (
            <a href={localePath(lang, l.href)} class="pill pill-ghost">{l.label}</a>
          ))}
        </div>

        <div class="mt-8 pt-8 border-t border-line flex flex-wrap justify-center gap-3">
          <a href={localePath(lang, '/')} class="pill pill-primary">
            Ucar Motors<Icon name="arrow-right" size={16} />
          </a>
          <a href={`tel:${tel}`} class="pill pill-ghost">
            <Icon name="phone" size={15} />{site.phones[0]}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
