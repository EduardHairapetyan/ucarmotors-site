---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { localePath, useTranslations, getLangFromUrl } from '../i18n/utils';

// Cloudflare serves one 404 for every path, so the locale cannot be known at
// build time. Default to Armenian and offer all three routes back.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base lang={lang} title="404" description="Page not found">
  <section class="shell py-12 sm:py-20">
    <div class="relative overflow-hidden card p-10 sm:p-16 max-w-2xl mx-auto text-center">
      <div class="spill -top-32 left-1/2 -translate-x-1/2 h-64 w-[28rem]" aria-hidden="true"></div>
      <div class="relative">
        <p class="payment text-6xl sm:text-7xl text-signal">404</p>
        <h1 class="text-title mt-5">Էջը չգտնվեց</h1>
        <p class="mt-3 text-ink-2">Страница не найдена · Page not found</p>

        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href={localePath(lang, '/cars')} class="pill pill-primary">
            {t('nav.cars')}<Icon name="arrow-right" size={16} />
          </a>
          <a href={localePath(lang, '/')} class="pill pill-ghost">Ucar Motors</a>
        </div>
      </div>
    </div>
  </section>
</Base>
