# Cloudflare Pages deploy. Token needs the "Cloudflare Pages: Edit" permission.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PROJECT=ucarmotors
CF_DOMAIN=ucarmotors.am

# Optional: enables the Facebook adapter in scripts/scrape.mjs
FB_PAGE_TOKEN=
FB_PAGE_ID=
